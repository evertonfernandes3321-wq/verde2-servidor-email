# ============================================
# Configuração do Servidor de Email Transacional
# ============================================
# Copie este arquivo para .env e preencha os valores

# ============================================
# API Configuration
# ============================================
API_PORT=3000
API_KEY=sua-api-key-aqui-mude-em-producao
JWT_SECRET=sua-jwt-secret-aqui-mude-em-producao

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=email_user
POSTGRES_PASSWORD=senha_banco_segura
POSTGRES_DB=email_db

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# SMTP Configuration
# ============================================
SMTP_HOST=postfix
SMTP_PORT=587
SMTP_USER=relay_user
SMTP_PASSWORD=senha_smtp_segura

# ============================================
# Email Domain Configuration
# ============================================
EMAIL_DOMAIN=seu-dominio.com
FROM_EMAIL=noreply@seu-dominio.com
