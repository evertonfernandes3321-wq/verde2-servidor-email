# The entrypoint requires and assigns these deployment values with postconf.
myhostname = unconfigured.invalid
mydomain = invalid
myorigin = $mydomain
mydestination =
inet_interfaces = all
inet_protocols = ipv4
mynetworks =
relay_domains =
relay_recipient_maps = regexp:/etc/postfix/bounce_recipients
transport_maps = regexp:/etc/postfix/transports
local_transport = error:local delivery disabled
default_transport = smtp
relay_transport = smtp
relayhost =
disable_vrfy_command = yes
smtpd_helo_required = yes
strict_rfc821_envelopes = yes
smtputf8_enable = no
smtpd_delay_reject = yes
smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = reject_unauth_destination
smtpd_sender_restrictions = check_sender_access regexp:/etc/postfix/dsn_senders
message_size_limit = 1048576
smtpd_recipient_limit = 1
smtpd_hard_error_limit = 5
smtpd_timeout = 60s
smtpd_sasl_type = cyrus
cyrus_sasl_config_path = /etc/postfix/sasl
smtpd_sasl_path = smtpd
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
smtpd_sasl_tls_security_options = noanonymous
smtpd_sasl_authenticated_header = no
smtpd_tls_cert_file = /run/secrets/submission.crt
smtpd_tls_key_file = /run/secrets/submission.key
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_security_level = may
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 0
smtpd_tls_loglevel = 0
maximal_queue_lifetime = 1d
bounce_queue_lifetime = 1d
delay_warning_time = 0
enable_long_queue_ids = yes
milter_protocol = 6
milter_default_action = tempfail
milter_connect_timeout = 5s
milter_command_timeout = 15s
milter_content_timeout = 30s
smtpd_milters =
non_smtpd_milters =
milter_connect_macros = j {daemon_name}
milter_mail_macros = i {auth_authen} {auth_type} {mail_addr}
milter_end_of_data_macros = i {auth_authen}
maillog_file =
syslog_name = postfix
compatibility_level = 3.6
queue_directory = /var/spool/postfix
data_directory = /var/lib/postfix
recipient_delimiter = +
import_environment = MAIL_CONFIG MAIL_DEBUG MAIL_LOGTAG TZ LANG=C INTERNAL_URL INTERNAL_TOKEN INTERNAL_CA_FILE BOUNCE_DOMAIN MAIL_INSTANCE_ID
export_environment = TZ LANG=C INTERNAL_URL INTERNAL_TOKEN INTERNAL_CA_FILE BOUNCE_DOMAIN MAIL_INSTANCE_ID
disable_mime_output_conversion = yes
smtp_header_checks = regexp:/etc/postfix/outbound_headers
